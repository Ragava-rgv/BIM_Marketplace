# Local Postgres — matches docker-compose.yml at the repo root (`docker compose up -d`).
# If you're using a native/manually-installed Postgres instead, update user/password/db to match.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/machinebazaar?schema=public

# Required — the app will fail to boot (passport-jwt throws "secretOrKey should be...")
# if these are blank. Generate strong local values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Leave blank (or prefix with "dev_") to print OTP codes to the API console
# instead of calling the real 2Factor.in SMS gateway — see OtpService.dispatch.
# Useful locally since the DLT template isn't registered yet.
OTP_PROVIDER_KEY=

# Leave blank (or prefix with "dev_") to stub GST lookups instead of calling
# the real gstverify.co.in API — see GstVerifyClient.lookupGstin.
GST_VERIFY_API_KEY=
GST_VERIFY_BASE_URL=https://gstverify.co.in

# On Railway: point STORAGE_LOCAL_PATH at the mounted Volume (e.g. /data/uploads)
# so uploaded files survive redeploys, and set MEDIA_BASE_URL to the public
# domain, e.g. https://${{RAILWAY_PUBLIC_DOMAIN}}/media
STORAGE_LOCAL_PATH=./uploads
MEDIA_BASE_URL=http://localhost:3001/media

# Optional — payment features are disabled (with a startup warning) if these
# are left blank, the app does not crash-loop without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=3001

ADMIN_SEED_EMAIL=admin@machinebazaar.in
ADMIN_SEED_PASSWORD=
ADMIN_SEED_PHONE=9999999999
