# Used only when building the native (Capacitor) app bundle — the WebView has no
# same-origin proxy to fall back on, so this must be the full production API URL.
# Local `npm run dev:mobile` / `npm run build:mobile` for plain web use ignore this
# and keep using the relative '/api' path (proxied in dev, same-origin if ever
# deployed as a website) unless this file is present at build time.
VITE_API_BASE_URL=https://bimmarketplace-production.up.railway.app/api
